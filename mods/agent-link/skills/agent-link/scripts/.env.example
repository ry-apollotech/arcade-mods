# agent-link settings: ~/.agent-link/.env (created by `agent_link_cli.py init`).
# Same token on both machines; PEER_IP points at the OTHER machine.
# Generate the token once with `agent_link_cli.py token` and share it privately.
SHARED_AGENT_TOKEN=
PEER_IP=192.168.1.50
PEER_PORT=8000
AGENT_NAME=my-agent

LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000
# Relative to ~/.agent-link
INBOX_DIR=inbox
OUTBOX_DIR=outbox
CLAUDE_BIN=claude
REVIEW_TIMEOUT_SECONDS=600

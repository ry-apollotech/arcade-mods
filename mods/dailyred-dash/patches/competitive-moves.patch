+// How much an attack is worth to this Pokemon, 0 if it isn't one worth using: its power (adjusted for
+// multi-hit, charging and recharging), times accuracy, times 1.5 for its own type, scaled down by how
+// much weaker the stat it uses (in Gen 3 a move's type decides which) is than the Pokemon's best one.
+static u32 AttackScore(u16 move, const struct SpeciesInfo *info)
+{
+    const struct BattleMove *data = &gBattleMoves[move];
+    u32 power = data->power;
+    u32 accuracy = data->accuracy != 0 ? data->accuracy : 100;
+    u32 stat = IS_TYPE_PHYSICAL(data->type) ? info->baseAttack : info->baseSpAttack;
+    u32 best = max(info->baseAttack, info->baseSpAttack);
+    u32 score;
+
+    if (power == 0 || IsUselessMove(move))
+        return 0;
+    switch (data->effect)
+    {
+    case EFFECT_LEVEL_DAMAGE: // Seismic Toss, Night Shade: 100 damage at level 100
+        power = 80;
+        break;
+    case EFFECT_MULTI_HIT:
+        power *= 3;
+        break;
+    case EFFECT_DOUBLE_HIT:
+    case EFFECT_TWINEEDLE:
+        power *= 2;
+        break;
+    case EFFECT_TRIPLE_KICK:
+        power = 45;
+        break;
+    case EFFECT_RECHARGE:
+        power = power * 3 / 5;
+        break;
+    case EFFECT_RAZOR_WIND:
+    case EFFECT_SKY_ATTACK:
+    case EFFECT_SKULL_BASH:
+    case EFFECT_SOLAR_BEAM:
+    case EFFECT_SEMI_INVULNERABLE:
+    case EFFECT_FOCUS_PUNCH:
+    case EFFECT_ROLLOUT:
+        power /= 2;
+        break;
+    case EFFECT_RAMPAGE:
+    case EFFECT_RECOIL_IF_MISS:
+        power = power * 4 / 5;
+        break;
+    case EFFECT_EXPLOSION:
+    case EFFECT_OHKO:
+    case EFFECT_DREAM_EATER:
+    case EFFECT_SNORE:
+    case EFFECT_FAKE_OUT:
+    case EFFECT_FUTURE_SIGHT:
+    case EFFECT_RAGE:
+        return 0;
+    default:
+        // Other fixed or variable damage (Hidden Power, Return, Flail, Counter...) is unreliable here.
+        if (power <= 1)
+            return 0;
+        break;
+    }
+
+    score = power * accuracy;
+    // Fixed damage gets no bonus for the Pokemon's own type.
+    if (data->effect != EFFECT_LEVEL_DAMAGE && (data->type == info->types[0] || data->type == info->types[1]))
+        score = score * 3 / 2;
+    if (best != 0)
+        score = score * stat / best * stat / best;
+    return score;
+}

+// One utility move from the pool that suits the chosen attacks, picked at random; MOVE_NONE if none.
+// Toxic only when nothing else fits: nearly everything learns it, and it would be on most sets.
+static u16 PickUtilityMove(const u16 *pool, u8 count, const u16 *attacks, u8 numAttacks, const struct SpeciesInfo *info, u32 *rng)
+{
+    u16 options[MAX_CANDIDATE_MOVES];
+    u8 numOptions = 0, physical = 0, i;
+    bool8 toxic = FALSE;
+    bool8 ghost = (info->types[0] == TYPE_GHOST || info->types[1] == TYPE_GHOST);
+
+    for (i = 0; i < numAttacks; i++)
+    {
+        if (IS_TYPE_PHYSICAL(gBattleMoves[attacks[i]].type))
+            physical++;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (pool[i] == MOVE_TOXIC)
+            toxic = TRUE;
+        else if (IsInList(pool[i], sUtilityMoves, ARRAY_COUNT(sUtilityMoves))
+         || (physical * 2 > numAttacks && IsInList(pool[i], sPhysicalBoosts, ARRAY_COUNT(sPhysicalBoosts))
+             && !(pool[i] == MOVE_CURSE && ghost))
+         || (physical * 2 < numAttacks && IsInList(pool[i], sSpecialBoosts, ARRAY_COUNT(sSpecialBoosts))))
+            options[numOptions++] = pool[i];
+    }
+    if (numOptions != 0)
+        return options[TeamRandom(rng) % numOptions];
+    return toxic ? MOVE_TOXIC : MOVE_NONE;
+}
+
+// A random move from the pool not chosen yet, skipping useless ones unless `anything`; MOVE_NONE if none.
+static u16 PickFillerMove(const u16 *pool, u8 count, const u16 *chosen, u8 numChosen, bool8 anything, u32 *rng)
+{
+    u16 options[MAX_CANDIDATE_MOVES];
+    u8 numOptions = 0, i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (!IsInList(pool[i], chosen, numChosen) && (anything || !IsUselessMove(pool[i])))
+            options[numOptions++] = pool[i];
+    }
+    return numOptions != 0 ? options[TeamRandom(rng) % numOptions] : MOVE_NONE;
+}

+extern const struct Evolution gEvolutionTable[][EVOS_PER_MON];
+
+// dailyred-dash: whether a species is the last of its line, i.e. evolves into nothing (Charizard,
+// Tauros and the legendaries are; Charmander and Charmeleon are not).
+static bool8 IsFinalEvolution(u16 species)
+{
+    u8 i;
+
+    for (i = 0; i < EVOS_PER_MON; i++)
+    {
+        if (gEvolutionTable[species][i].method != 0)
+            return FALSE;
+    }
+    return TRUE;
+}
